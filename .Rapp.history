library(torch)
remove.packages("torch")
q()
remotes::install_version("torch", version = "0.16.3", repos = "https://cloud.r-project.org")
tmp <- tempfile(); dir.create(tmp)#
tgz <- file.path(tmp, "torch_0.16.3.tar.gz")#
download.file("https://cloud.r-project.org/src/contrib/Archive/torch/torch_0.16.3.tar.gz", tgz)#
untar(tgz, exdir = tmp)#
#
f <- file.path(tmp, "torch", "src", "indexing.cpp")#
x <- readLines(f)#
x <- sub("Rf_findVarInFrame(env, R_DotsSymbol)",#
         "R_getVarEx(R_DotsSymbol, env, FALSE, R_NilValue)", x, fixed = TRUE)#
stopifnot(any(grepl("R_getVarEx", x)))   # confirms the patch applied#
writeLines(x, f)#
#
install.packages(file.path(tmp, "torch"), repos = NULL, type = "source")
torch::install_torch()
q()
