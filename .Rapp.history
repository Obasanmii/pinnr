#
# DESCRIPTION: add ORCID to the author entry#
d <- readLines("DESCRIPTION")#
d <- sub('role = c("aut", "cre"))',#
         'role = c("aut", "cre"),\n           comment = c(ORCID = "0009-0009-6935-5479"))',#
         d, fixed = TRUE)#
writeLines(d, "DESCRIPTION")#
#
# CITATION.cff: add ORCID under the author's email#
