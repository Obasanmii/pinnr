library(torch)#
x <- matrix(c(1, 2, 3), ncol = 1)#
a <- torch_tensor(x, dtype = torch_float64())#
b <- torch_tensor(x, dtype = torch_float64())#
a$storage()$data_ptr() == b$storage()$data_ptr()
a32 <- torch_tensor(x, dtype = torch_float32())#
b32 <- torch_tensor(x, dtype = torch_float32())#
a32$storage()$data_ptr() == b32$storage()$data_ptr()   # expect FALSE
devtools::document("~/Desktop/pinnr")#
devtools::check("~/Desktop/pinnr", vignettes = FALSE)
setwd("~/Desktop/pinnr")#
doi <- "10.5281/zenodo.23835717"#
#
# README: DOI badge next to the R-CMD-check badge#
r <- readLines("README.md")#
i <- grep("R-CMD-check.yaml/badge.svg", r, fixed = TRUE)#
r <- append(r, sprintf("[![DOI](https://zenodo.org/badge/DOI/%s.svg)](https://doi.org/%s)", doi, doi), after = i)#
writeLines(r, "README.md")#
#
# CITATION.cff: add the DOI and bring version/date up to date#
cff <- readLines("CITATION.cff")#
cff <- sub("^version: .*", "version: 0.1.1", cff)#
cff <- sub("^date-released: .*", "date-released: 2026-10-31", cff)#
cff <- append(cff, paste("doi:", doi), after = grep("^license:", cff))#
writeLines(cff, "CITATION.cff")
